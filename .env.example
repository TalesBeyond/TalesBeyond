# Copy this file to .env and fill in your Supabase project's values
# (Project Settings -> Data API for the URL, Project Settings -> API Keys
# for the key) to switch the app from local-only Phase 1 mode into
# cloud-synced mode. See supabase/README.md.
#
# Leave this file absent, or leave the values blank, to keep running
# entirely locally with no backend at all.

VITE_SUPABASE_PROJECT_URL=
# ---- Admin script only (npm run catalog:seed) ----
# The service-role (secret) key lets scripts/catalog-admin.mjs write the
# Default catalog. It is deliberately NOT prefixed VITE_, so Vite never puts it
# in the app bundle. Never commit a real value.
# SUPABASE_SERVICE_ROLE_KEY=

VITE_SUPABASE_PUBLISHABLE_KEY=
