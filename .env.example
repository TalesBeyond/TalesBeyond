# Copy this file to .env and fill in your Supabase project's values
# (Project Settings -> Data API for the URL, Project Settings -> API Keys
# for the key) to switch the app from local-only Phase 1 mode into
# cloud-synced mode. See supabase/README.md.
#
# Leave this file absent, or leave the values blank, to keep running
# entirely locally with no backend at all.

VITE_SUPABASE_PROJECT_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
